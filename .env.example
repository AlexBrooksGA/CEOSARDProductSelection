# Copy this file to .env and replace placeholders locally. Never commit .env.
MIMS_API_USERNAME=your_username
MIMS_API_PASSWORD=your_password
MIMS_API_BASE_URL=https://eo-explorer-demo.diamondsky.au/api

# Controls whether the default-off experimental FedEO sidebar toggle is available.
ENABLE_FEDEO_INTEGRATION=true
