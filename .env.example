# Copy to .env and adjust locally. Never commit .env.
# MIM works with no settings at all: it reads the public CEOS Database API
# (https://ceos-capabilities.org/api, CC BY 4.0) with no credentials.

# API root (not the Swagger URL). HTTPS required (http only for localhost testing).
# Set to "off" to turn MIM off for this deployment.
# MIMS_API_BASE_URL=https://ceos-capabilities.org/api

# Optional free API key for higher rate limits (email support@ceos-capabilities.org).
# Sent as the X-API-Key header, on the server only.
# MIMS_API_KEY=

# Optional Basic credentials, only for an older authenticated MIM deployment. Set both or neither.
# MIMS_API_USERNAME=
# MIMS_API_PASSWORD=

# Optional tuning (defaults shown).
# MIMS_CACHE_TTL_SECONDS=21600
# MIMS_REFRESH_COOLDOWN_SECONDS=60
# MIMS_FAILURE_BACKOFF_SECONDS=30

# Node server (adapter-node). Set ORIGIN to the public URL when deployed.
# PORT=3000
# HOST=0.0.0.0
# ORIGIN=https://explorer.example.org
