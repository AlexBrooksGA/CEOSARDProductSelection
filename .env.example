# Copy to .env and replace the placeholders locally. Never commit .env.
# Optional: without these the curated catalogue works fully and MIM shows "not configured".
MIMS_API_USERNAME=your_username
MIMS_API_PASSWORD=your_password
# API root (not the Swagger URL). Must be HTTPS (http is accepted only for localhost testing).
MIMS_API_BASE_URL=https://eo-explorer-demo.diamondsky.au/api

# Optional tuning (defaults shown).
# MIMS_CACHE_TTL_SECONDS=21600
# MIMS_REFRESH_COOLDOWN_SECONDS=60
# MIMS_FAILURE_BACKOFF_SECONDS=30

# Node server (adapter-node). Set ORIGIN to the public URL when deployed.
# PORT=3000
# HOST=0.0.0.0
# ORIGIN=https://explorer.example.org
