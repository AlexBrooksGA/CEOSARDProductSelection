      "additionalProperties": false,
      "properties": {
        "bands": {
          "items": {
            "$ref": "#/$defs/ChangeBand"
          },
          "title": "Bands",
          "type": "array"
        },
        "stale_after_hours": {
          "exclusiveMinimum": 0,
          "title": "Stale After Hours",
          "type": "integer"
        }
      },
      "required": [
        "bands",
        "stale_after_hours"
      ],
      "title": "AlertPolicy",
      "type": "object"
    },
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "checksum": {
          "$ref": "#/$defs/Checksum"
        },
        "href": {
          "minLength": 1,
          "title": "Href",
          "type": "string"
        },
        "origin": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin"
        },
        "pixel_size_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pixel Size M"
        },
        "role": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "href",
        "bytes",
        "checksum"
      ],
      "title": "Asset",
      "type": "object"
    },
    "ChangeBand": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "exclusiveMinimum": 0,
          "title": "Limit",
          "type": "number"
        },
        "series_id": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Series Id",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "series_id",
        "unit",
        "limit",
        "source"
      ],
      "title": "ChangeBand",
      "type": "object"
    },
    "CheckOutcome": {
      "enum": [
        "completed",
        "not_assessed",
        "not_applicable",
        "execution_error"
      ],
      "title": "CheckOutcome",
      "type": "string"
    },
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+@\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$",
          "title": "Check",
          "type": "string"
        },
        "created": {
          "format": "date-time",
          "title": "Created",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "exclusions": {
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "title": "Exclusions",
          "type": "object"
        },
        "follows": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Follows"
        },
        "idempotency_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/InputRef"
          },
          "title": "Inputs",
          "type": "array"
        },
        "measurements": {
          "items": {
            "$ref": "#/$defs/Measurement"
          },
          "title": "Measurements",
          "type": "array"
        },
        "method": {
          "$ref": "#/$defs/Method"
        },
        "outcome": {
          "$ref": "#/$defs/CheckOutcome"
        },
        "product_version": {
          "pattern": "^pv-[0-9a-f]{64}$",
          "title": "Product Version",
          "type": "string"
        },
        "quality_flags": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Quality Flags",
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reason"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReferenceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "result_id": {
          "format": "uuid",
          "title": "Result Id",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "result_id",
        "created",
        "run_id",
        "product_version",
        "check",
        "idempotency_key",
        "outcome",
        "method"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "Checksum": {
      "additionalProperties": false,
      "properties": {
        "alg": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Alg",
          "type": "string"
        },
        "source": {
          "enum": [
            "provider",
            "computed"
          ],
          "title": "Source",
          "type": "string"
        },
        "value": {
          "minLength": 8,
          "pattern": "^[0-9a-f]+$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "alg",
        "value",
        "source"
      ],
      "title": "Checksum",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Kind",
          "type": "string"
        },
        "uri": {
          "pattern": "^evidence://sha256/[0-9a-f]{64}$",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "uri"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Grid": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        },
        "scheme": {
          "minLength": 1,
          "title": "Scheme",
          "type": "string"
        }
      },
      "required": [
        "scheme",
        "ref"
      ],
      "title": "Grid",
      "type": "object"
    },
    "InputRef": {
      "additionalProperties": false,
