      "enum": [
        "operational",
        "experimental",
        "test_double",
        "awaiting_dependency"
      ],
      "title": "Maturity",
      "type": "string"
    },
    "Measurement": {
      "additionalProperties": false,
      "properties": {
        "n_total": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Total"
        },
        "n_valid": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Valid"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "per": {
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "minLength": 1,
              "type": "string"
            }
          },
          "title": "Per",
          "type": "object"
        },
        "uncertainty": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uncertainty"
            },
            {
              "$ref": "#/$defs/NotEstimated"
            }
