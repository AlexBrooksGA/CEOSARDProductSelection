            {
              "format": "uuid",
              "type": "string"
            }
          ],
          "title": "Result Ids",
          "type": "array"
        },
        "segment_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Segment Id",
          "type": "string"
        },
        "series_id": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Series Id",
          "type": "string"
        },
        "statement": {
          "const": "Observed change exceeds the configured advisory band.",
          "default": "Observed change exceeds the configured advisory band.",
          "title": "Statement",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "series_id",
        "segment_id",
        "result_ids",
        "observed_change",
        "unit",
        "band"
      ],
      "title": "QualityAlert",
      "type": "object"
    },
    "Reason": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[a-z][a-z0-9_]*$",
