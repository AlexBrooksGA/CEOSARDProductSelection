    "QualityAlert": {
      "additionalProperties": false,
      "properties": {
        "band": {
          "$ref": "#/$defs/ChangeBand"
        },
        "kind": {
          "const": "quality",
          "default": "quality",
          "title": "Kind",
          "type": "string"
        },
        "observed_change": {
          "title": "Observed Change",
          "type": "number"
        },
        "result_ids": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "format": "uuid",
              "type": "string"
