        "checksum": {
          "minLength": 8,
          "pattern": "^[0-9a-f]+$",
          "title": "Checksum",
          "type": "string"
        },
        "role": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "checksum"
      ],
      "title": "InputRef",
      "type": "object"
    },
    "JsonValue": {},
